{
  "name": "execution-timer",
  "displayName": "Execution Timer",
  "description": "Track debug session runtime in the VS Code status bar",
  "version": "1.0.1",
  "publisher": "yyhaos",
  "engines": {
    "vscode": "^1.50.0",
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yyhaos/execution-timer.git"
  },
  "activationEvents": [
    "onDebug",
    "onCommand:extension.resetTimer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.resetTimer",
        "title": "Reset Timer",
        "category": "Execution Timer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p ./tsconfig.test.json",
    "watch": "tsc --watch -p ./",
    "lint": "eslint src/**/*.ts",
    "test": "npm run compile:test && node --test out-test/test/timer.test.js",
    "check": "npm run compile && npm run lint && npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.50.0",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
